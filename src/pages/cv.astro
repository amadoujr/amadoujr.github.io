---
import Layout from "../layouts/Layout.astro";
import TechBadge from "../components/TechBadge.astro";

const experiences = [
  {
    role: "AI & Data Engineer (Freelance)",
    company: "Meet My Mama",
    location: "Paris",
    period: "Oct. 2025 — Présent",
    items: [
      "Conception, maintenance et optimisation du data warehouse Supabase",
      "Déploiement d'un agent IA agentique pour l'interrogation du data warehouse en langage naturel",
      "Déploiement d'un chatbot RAG interne d'assistance (pgvector + Claude)",
      "Industrialisation de modèles ML prédictifs (LTV BG/NBD + Gamma-Gamma, churn)",
      "Reporting et dashboards Metabase pour l'ensemble des équipes",
    ],
    tech: ["Python", "SQL", "Supabase", "Metabase", "LLMs", "RAG", "dbt"],
  },
  {
    role: "AI & Data Engineer (Stage M2)",
    company: "Meet My Mama",
    location: "Paris",
    period: "Juin 2025 — Oct. 2025",
    items: [
      "Automatisation de workflows métier via n8n",
      "Pipelines ETL Salesforce → Supabase",
      "Reporting et dashboards BI avec Metabase",
      "API de matching lead → CDP (scoring multi-critères pondéré)",
      "Segmentation RFM et scoring de prospects",
    ],
    tech: ["n8n", "Python", "Supabase", "Salesforce API", "FastAPI", "Metabase"],
  },
  {
    role: "Chatbot médical IA",
    company: "Projet académique",
    location: "Université de Lille",
    period: "Jan. 2025 — Mars 2025",
    items: [
      "Système de question-réponse médical pour zones sinistrées",
      "Architecture RAG avec modèles HuggingFace",
      "Interfaces Gradio et Streamlit",
    ],
    tech: ["Python", "HuggingFace", "RAG", "LangChain", "Gradio"],
  },
];

const skills = [
  { cat: "Langages", items: "Python · SQL · Bash" },
  { cat: "Data Engineering", items: "PostgreSQL · Supabase · dbt · n8n · Airflow · ETL · Docker · BeautifulSoup" },
  { cat: "Agents IA / LLMs", items: "LangChain · LangGraph · MCP · RAG · OpenRouter · Anthropic · OpenAI" },
  { cat: "Machine Learning", items: "scikit-learn · PyTorch · NLP · lifetimes (BG/NBD) · MLflow" },
  { cat: "BI & Cloud", items: "Metabase · BigQuery · Looker · GCP · Railway" },
  { cat: "MLOps", items: "MLflow · FastAPI · Streamlit · Gradio · Docker" },
];

const education = [
  { degree: "Master 2 — Machine Learning", school: "Université de Lille", period: "2023 — 2025" },
  { degree: "Licence — Informatique & Mathématiques", school: "Université de Lille", period: "2020 — 2023" },
];
---

<Layout
  current="cv"
  title="CV — Amadou Barro"
  description="Parcours professionnel et compétences techniques d'Amadou Barro, AI & Data Engineer."
>
  <article class="container-page max-w-4xl py-16">
    <header class="flex flex-col items-start justify-between gap-6 border-b border-[var(--color-border)] pb-10 sm:flex-row sm:items-end">
      <div>
        <h1 class="text-5xl font-extrabold tracking-tight">CV</h1>
        <p class="mt-3 text-lg text-[var(--color-muted)]">
          AI & Data Engineer · Paris · Ouvert aux opportunités CDI
        </p>
      </div>
      <a
        href="/Amadou_Barro_CV.pdf"
        download
        class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-accent)] px-5 py-2.5 text-sm font-semibold text-[var(--color-bg)] transition-transform hover:scale-[1.02]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
        Télécharger le PDF
      </a>
    </header>

    <!-- EXPERIENCES -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold tracking-tight mb-8">Expériences professionnelles</h2>
      <div class="space-y-10">
        {experiences.map((exp) => (
          <div class="relative pl-6 border-l-2 border-[var(--color-border)]">
            <span class="absolute -left-[7px] top-1 h-3 w-3 rounded-full bg-[var(--color-accent)]"></span>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-lg font-semibold">{exp.role}</h3>
              <span class="font-mono text-xs text-[var(--color-muted)]">{exp.period}</span>
            </div>
            <p class="mt-1 text-sm text-[var(--color-muted)]">
              <span class="text-[var(--color-accent)]">{exp.company}</span> · {exp.location}
            </p>
            <ul class="mt-4 space-y-1.5 text-sm text-[var(--color-muted)]">
              {exp.items.map((item) => (
                <li class="flex gap-2">
                  <span class="text-[var(--color-accent)] shrink-0">▹</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {exp.tech.map((t) => <TechBadge label={t} />)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight mb-8">Formation</h2>
      <div class="space-y-6">
        {education.map((edu) => (
          <div class="relative pl-6 border-l-2 border-[var(--color-border)]">
            <span class="absolute -left-[7px] top-1 h-3 w-3 rounded-full bg-[var(--color-accent)]"></span>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-base font-semibold">{edu.degree}</h3>
              <span class="font-mono text-xs text-[var(--color-muted)]">{edu.period}</span>
            </div>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{edu.school}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- SKILLS -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight mb-8">Compétences techniques</h2>
      <dl class="grid gap-4 sm:grid-cols-2">
        {skills.map((s) => (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            <dt class="text-xs uppercase tracking-wider text-[var(--color-accent)] font-semibold">{s.cat}</dt>
            <dd class="mt-2 text-sm text-[var(--color-muted)]">{s.items}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- LANGUAGES -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight mb-6">Langues</h2>
      <ul class="space-y-2 text-sm text-[var(--color-muted)]">
        <li><strong class="text-[var(--color-text)]">Français</strong> — Courant</li>
        <li><strong class="text-[var(--color-text)]">Anglais</strong> — Intermédiaire</li>
        <li><strong class="text-[var(--color-text)]">Arabe</strong> — Langue nationale</li>
      </ul>
    </section>
  </article>
</Layout>
