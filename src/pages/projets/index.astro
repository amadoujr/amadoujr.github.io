---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

const categories = [
  "Tous",
  "Agent IA / LLM",
  "Data Engineering",
  "Machine Learning",
  "Produit",
  "Autre",
];

const contexts = ["Tous", "Meet My Mama", "Personnel", "Académique"];
---

<Layout
  current="projets"
  title="Projets — Amadou Barro"
  description="Sélection de projets data et IA — agents autonomes, RAG, ML, data warehouses, BI."
>
  <section class="container-page pt-16 pb-8">
    <h1 class="text-5xl font-extrabold tracking-tight">Projets</h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-muted)]">
      Sélection de projets data et IA réalisés en production, en stage et en perso. Cliquez pour voir le détail.
    </p>

    <!-- Filter: Category -->
    <div class="mt-10">
      <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-[var(--color-muted)]">Catégorie</p>
      <div class="flex flex-wrap gap-2" id="category-filter-bar">
        {categories.map((cat) => (
          <button
            type="button"
            data-filter={cat}
            class:list={[
              "category-filter-btn rounded-full border px-4 py-1.5 text-sm transition-all",
              cat === "Tous"
                ? "border-[var(--color-accent)] bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold"
                : "border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-muted)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-text)]",
            ]}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Filter: Context -->
    <div class="mt-6">
      <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-[var(--color-muted)]">Contexte</p>
      <div class="flex flex-wrap gap-2" id="context-filter-bar">
        {contexts.map((ctx) => (
          <button
            type="button"
            data-filter={ctx}
            class:list={[
              "context-filter-btn rounded-full border px-4 py-1.5 text-sm transition-all",
              ctx === "Tous"
                ? "border-[var(--color-accent)] bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold"
                : "border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-muted)] hover:border-[var(--color-accent)]/50 hover:text-[var(--color-text)]",
            ]}
          >
            {ctx}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page pb-24">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" id="projects-grid">
      {allProjects.map((project) => (
        <div data-category={project.data.category} data-context={project.data.context}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
    <p id="empty-state" class="hidden mt-12 text-center text-[var(--color-muted)]">
      Aucun projet ne correspond à ces filtres.
    </p>
  </section>
</Layout>

<script>
  type ActiveBtn = HTMLButtonElement;
  const categoryButtons = document.querySelectorAll<ActiveBtn>(".category-filter-btn");
  const contextButtons = document.querySelectorAll<ActiveBtn>(".context-filter-btn");
  const cards = document.querySelectorAll<HTMLElement>("#projects-grid > [data-category]");
  const emptyState = document.getElementById("empty-state");

  let activeCategory = "Tous";
  let activeContext = "Tous";

  function setActive(buttons: NodeListOf<ActiveBtn>, active: ActiveBtn) {
    buttons.forEach((b) => {
      const isActive = b === active;
      b.classList.toggle("bg-[var(--color-accent)]", isActive);
      b.classList.toggle("text-[var(--color-bg)]", isActive);
      b.classList.toggle("border-[var(--color-accent)]", isActive);
      b.classList.toggle("font-semibold", isActive);
      b.classList.toggle("bg-[var(--color-surface)]", !isActive);
      b.classList.toggle("text-[var(--color-muted)]", !isActive);
      b.classList.toggle("border-[var(--color-border)]", !isActive);
    });
  }

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const cat = card.dataset.category;
      const ctx = card.dataset.context;
      const show =
        (activeCategory === "Tous" || cat === activeCategory) &&
        (activeContext === "Tous" || ctx === activeContext);
      card.style.display = show ? "" : "none";
      if (show) visible++;
    });
    if (emptyState) emptyState.classList.toggle("hidden", visible > 0);
  }

  categoryButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      setActive(categoryButtons, btn);
      activeCategory = btn.dataset.filter ?? "Tous";
      applyFilters();
    });
  });

  contextButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      setActive(contextButtons, btn);
      activeContext = btn.dataset.filter ?? "Tous";
      applyFilters();
    });
  });
</script>
