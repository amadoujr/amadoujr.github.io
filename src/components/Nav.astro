---
const { current = "" } = Astro.props;

const links = [
  { href: "/", label: "Accueil", key: "home" },
  { href: "/projets/", label: "Projets", key: "projets" },
  { href: "/about/", label: "À propos", key: "about" },
  { href: "/cv/", label: "CV", key: "cv" },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur-md">
  <nav class="container-page flex h-16 items-center justify-between">
    <a href="/" class="group flex items-center gap-2 font-mono text-sm font-semibold">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-[var(--color-accent)] text-[var(--color-bg)] font-bold transition-transform group-hover:scale-110">
        AB
      </span>
      <span class="hidden sm:inline">amadou.barro</span>
    </a>

    <ul class="flex items-center gap-1 text-sm">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class={`relative rounded-md px-3 py-1.5 transition-colors hover:text-[var(--color-accent)] ${
              current === link.key
                ? "text-[var(--color-accent)]"
                : "text-[var(--color-muted)]"
            }`}
          >
            {link.label}
            {current === link.key && (
              <span class="absolute -bottom-[17px] left-0 right-0 h-0.5 bg-[var(--color-accent)]"></span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
